{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api",
    "KeyId": "identity-1"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": { "Market": "IN", "GoogleClientId": "" },
      "skillmuni-za": { "Market": "ZA", "GoogleClientId": "" }
    }
  },
  "Identity": {
    "TriesPerCode": 5,
    "CodeLifetime": "00:10:00",
    "ResendAfter": "00:00:30",
    "MaxCodesPerHour": 5,
    "AccessTokenLifetime": "00:10:00",
    "IdleTimeout": "00:30:00",
    "SessionMaxAge": "30.00:00:00",
    "PrivacyPolicyVersion": "2026-10"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "Topic": "skillmuni-events",
    "NotificationsQueue": "notifications"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  }
}
