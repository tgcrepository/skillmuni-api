{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": { "Market": "IN" },
      "skillmuni-za": { "Market": "ZA" }
    }
  },
  "Cv": {
    "MaxPages": 10,
    "UploadsPerDay": 10,
    "SupportedLanguages": [ "en", "hi" ],
    "KeepOriginalFor": "30.00:00:00",
    "IdentityBaseAddress": "http://identity:8080/",
    "Storage": { "Container": "cv-files" },
    "Reader": { "Mode": "document-intelligence", "Model": "prebuilt-read" }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "Topic": "skillmuni-events",
    "Subscription": "cv"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  }
}
