{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": {
        "Market": "IN"
      },
      "skillmuni-za": {
        "Market": "ZA"
      }
    },
    "Hosts": {}
  },
  "Gateway": {
    "AllowedOrigins": [],
    "GlobalPerMinute": 300,
    "AuthPerMinute": 20,
    "RefreshWhenOlderThan": "00:02:00",
    "IdentityBaseAddress": "http://identity:8080/"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        }
      },
      "identity-session": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/session"
        }
      },
      "identity-claims": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/claims/{**rest}"
        }
      },
      "identity-me-phone": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/me/phone/{**rest}"
        }
      },
      "identity-profile-contact": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/v1/profile/contact/{**rest}"
        }
      },
      "identity-me-consents": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/consents/{**rest}"
        }
      },
      "identity-me-sessions": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/sessions/{**rest}"
        }
      },
      "identity-me-data-export": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/data-export"
        }
      },
      "identity-me-erase": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me",
          "Methods": [
            "DELETE"
          ]
        }
      },
      "identity-admin-claims": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/admin/claims/{**rest}"
        }
      },
      "learner-me-quests": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/quests/{**rest}"
        }
      },
      "learner-me-identity": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/identity/{**rest}"
        }
      },
      "learner-me-programme": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/programme"
        }
      },
      "learner-me-feedback": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/feedback"
        }
      },
      "learner-me-trophies": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/trophies/{**rest}"
        }
      },
      "learner-me-preferences": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/preferences"
        }
      },
      "learner-drafts": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/drafts/{**rest}"
        }
      },
      "learner-programmes": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/programmes/{**rest}"
        }
      },
      "learner-banks": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/banks/{**rest}"
        }
      },
      "learner-profile": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/profile/{**rest}"
        }
      },
      "learner-skills": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/skills/{**rest}"
        }
      },
      "learner-admin-programmes": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/admin/programmes/{**rest}"
        }
      },
      "cv": {
        "ClusterId": "cv",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/cv/{**rest}"
        }
      },
      "gamification-arena": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/arena/{**rest}"
        }
      },
      "gamification-stats-rewards": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/stats/rewards"
        }
      },
      "gamification-badges": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/badges/{**rest}"
        }
      },
      "gamification-me-xp": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/xp/{**rest}"
        }
      },
      "gamification-me-streak": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/streak"
        }
      },
      "gamification-me-daily-quests": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/daily-quests"
        }
      },
      "gamification-me-progress": {
        "ClusterId": "gamification",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/me/progress"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "learner": {
        "Destinations": {
          "primary": {
            "Address": "http://learner:8080/"
          }
        }
      },
      "cv": {
        "Destinations": {
          "primary": {
            "Address": "http://cv:8080/"
          }
        }
      },
      "gamification": {
        "Destinations": {
          "primary": {
            "Address": "http://gamification:8080/"
          }
        }
      }
    }
  }
}
