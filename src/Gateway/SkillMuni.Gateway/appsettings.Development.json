{
  "Gateway": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-openapi": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/openapi/identity/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/openapi/{**rest}"
          }
        ]
      },
      "learner-openapi": {
        "ClusterId": "learner",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/openapi/learner/{**rest}"
        },
