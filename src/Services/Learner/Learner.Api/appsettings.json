{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": { "Market": "IN" },
      "skillmuni-za": { "Market": "ZA" }
    }
  },
  "Learner": {
    "ProgrammeTries": 5,
    "ProgrammeCoolDown": "00:30:00",
    "FeedbackXpEvery": "30.00:00:00",
    "Xp": {
      "QuestStep": 20,
      "QuestComplete": 50,
      "Programme": 100,
      "Feedback": 5,
      "ProfilePhoto": 5,
      "ProfileSkills": 10
    },
    "JobProfile": {
      "ShareBaseUrl": "https://skillmuni.app",
      "MaxCvBytes": 5242880
    },
    "Storage": {
      "Container": "learner-files"
    },
    "DigiLocker": {
      "Mode": "off"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "Topic": "skillmuni-events",
    "Subscription": "learner"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  }
}
