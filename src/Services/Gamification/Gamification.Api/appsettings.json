{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": { "Market": "IN" },
      "skillmuni-za": { "Market": "ZA" }
    }
  },
  "Gamification": {
    "Xp": {
      "QuestStep": 20,
      "QuestComplete": 50,
      "ProfilePhoto": 5,
      "ProfileSkills": 10,
      "Programme": 100,
      "Feedback": 5,
      "CareerDrivers": 20,
      "ClaimConfirmed": 100,
      "QuizCorrectAnswer": 1
    },
    "Arena": {
      "BoardSize": 50,
      "StreakBonus": 5,
      "PromotionRank": 3,
      "League": "Gold League",
      "CacheFor": "00:01:00"
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "Topic": "skillmuni-events",
    "Subscription": "gamification"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  }
}
