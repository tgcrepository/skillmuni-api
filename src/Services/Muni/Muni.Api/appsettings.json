{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": { "Market": "IN" },
      "skillmuni-za": { "Market": "ZA" }
    }
  },
  "Muni": {
    "HistoryDays": 90,
    "ConversationGap": "00:30:00",
    "HistoryConversations": 20,
    "LearnerBaseAddress": "http://learner:8080/",
    "Cleanup": { "Enabled": true, "Every": "06:00:00", "Batch": 1000 }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "Topic": "skillmuni-events",
    "Subscription": "muni"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  }
}
