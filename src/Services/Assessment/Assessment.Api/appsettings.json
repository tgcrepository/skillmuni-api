{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "skillmuni-identity",
    "Audience": "skillmuni-api"
  },
  "Tenancy": {
    "DefaultTenant": "skillmuni-in",
    "Tenants": {
      "skillmuni-in": { "Market": "IN" },
      "skillmuni-za": { "Market": "ZA" }
    }
  },
  "Assessment": {
    "XpPerIsland": 25,
    "XpOnSubmit": 25,
    "MandatoryCourses": 2
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ServiceBus": {
    "Topic": "skillmuni-events",
    "Subscription": "assessment"
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02"
  }
}
